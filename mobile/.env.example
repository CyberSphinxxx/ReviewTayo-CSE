# ReviewTayo mobile environment configuration
#
# Copy to `.env.local` for local development. Only `EXPO_PUBLIC_*` variables are
# inlined into the client bundle, and nothing secret may ever be placed here.
# Anything genuinely secret belongs on the backend, never in the app.

# ReviewTayo HTTP API base URL. Leave empty to run the app fully offline with the
# bundled content pack and a local-only sync transport (default for QA builds).
EXPO_PUBLIC_API_BASE_URL=

# Google OAuth client IDs. Live sign-in is verified against these; until they are
# provided the app uses the fake provider and Guest mode remains fully functional.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Environment label surfaced in Settings > About and used by logging.
EXPO_PUBLIC_APP_ENV=development
